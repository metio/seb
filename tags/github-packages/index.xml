&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nt"&gt;&amp;lt;name&amp;gt;&lt;/span&gt;GitHub maven-build-process Apache Maven Packages&lt;span class="nt"&gt;&amp;lt;/name&amp;gt;&lt;/span&gt;
