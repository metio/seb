<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Status Bar on Sebastian Hoß</title><link>https://seb.xn--ho-hia.de/tags/status-bar/</link><description>Recent content in Status Bar on Sebastian Hoß</description><generator>Hugo</generator><language>en</language><lastBuildDate>Fri, 06 Jan 2023 16:22:24 +0100</lastBuildDate><atom:link href="https://seb.xn--ho-hia.de/tags/status-bar/index.xml" rel="self" type="application/rss+xml"/><item><title>tmux Status Bar</title><link>https://seb.xn--ho-hia.de/posts/tmux-status-bar/</link><pubDate>Mon, 09 Aug 2021 00:00:00 +0000</pubDate><guid>https://seb.xn--ho-hia.de/posts/tmux-status-bar/</guid><description>&lt;p&gt;To see the currently active &lt;a href="https://github.com/tmux/tmux"&gt;tmux&lt;/a&gt; status bar configuration, call:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;$ tmux show-options -g &lt;span class="p"&gt;|&lt;/span&gt; grep status
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;Change on of those values with in the current tmux session:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;$ tmux set-option status-right &lt;span class="s2"&gt;&amp;#34;&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;Persist the change in your &lt;code&gt;tmux.conf&lt;/code&gt; like this:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-shell" data-lang="shell"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="c1"&gt;# disable right side of status bar&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;set-option -g status-right &lt;span class="s2"&gt;&amp;#34;&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</description></item></channel></rss>